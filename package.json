{
  "name": "terragent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "provision:agentmail": "tsx scripts/provision-agentmail.ts",
    "db:status": "tsx scripts/db-status.ts",
    "test:live": "vitest run --config vitest.live.config.mts",
    "pipeline": "tsx scripts/pipeline.ts",
    "bundle:pipeline": "tsx scripts/bundle-pipeline.ts",
    "test:pipeline": "bash pipeline/bootstrap.sh --dev >/dev/null && pipeline/.venv/bin/python -m pytest -q pipeline/tests"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@usenaive-sdk/managed-agents": "^0.12.3",
    "agentmail": "^0.5.53",
    "h3-js": "^4.5.0",
    "mcp-handler": "^2.3.1",
    "nanoid": "^5.1.16",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-globe.gl": "^2.38.0",
    "svix": "^2.9.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
