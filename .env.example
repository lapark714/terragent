# Terragent environment. Copy to .env (gitignored) and fill in. NAMES ONLY here — never commit values.

# --- Naïve (main track) ---------------------------------------------------
# Local provisioning key (may hold admin + billing:write — NEVER deploy it; see NOTES H1d).
VETTA_API_KEY=
# Optional; defaults to https://api.vetta.sh
VETTA_BASE_URL=
# Runtime key for Vercel: no admin, no billing:write. The deployed app refuses keys with those scopes.
# On Vercel set VETTA_API_KEY to this narrow key.

# --- AgentMail (all email) -------------------------------------------------
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_HELLO=terragent@agentmail.to
AGENTMAIL_INBOX_DATA=terragent-data@agentmail.to
AGENTMAIL_INBOX_OUTREACH=terragent-outreach@agentmail.to

# --- Monid (business signals, contacts) ------------------------------------
MONID_API_KEY=

# --- Neon Postgres ---------------------------------------------------------
# Pooled connection string. Unset = local PGlite in .pglite/ (or TERRAGENT_DB=memory).
DATABASE_URL=

# --- Free data feeds -------------------------------------------------------
FIRMS_MAP_KEY=
GFW_API_KEY=

# --- App -------------------------------------------------------------------
# Public origin (https://<project>.vercel.app). Agents, webhooks and report links use it.
PUBLIC_BASE_URL=
# Shared secret for founder actions in the dashboard (approve orders/templates, arm inboxes).
ADMIN_TOKEN=
# Comma-separated team addresses that may receive mail before an inbox is armed (testing).
TEAM_EMAILS=
# Set to true ONLY after AgentMail OKs direct cold email in writing (NOTES H2f).
OUTREACH_DIRECT_EMAIL_APPROVED=false
# Optional Stripe Payment Link shown on quotes (a human creates it).
PAYMENT_LINK_URL=
