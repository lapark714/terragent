+export async function postAdmin(session: AdminSession, action: string, body: Record<string, unknown>) {
+  const res = await fetch(`/api/admin/${action}`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "x-admin-token": session.token },
+    body: JSON.stringify({ ...body, actor: session.actor }),
+  });
+  const json = await res.json().catch(() => ({}));
+  const issue = Array.isArray(json.issues) ? (json.issues[0]?.message as string | undefined) : undefined;
+  return { ok: res.ok, status: res.status, message: (json.done ?? json.message ?? issue ?? json.error ?? `Failed (${res.status})`) as string };
+}
