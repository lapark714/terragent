diff --git a/src/components/request/poll.test.ts b/src/components/request/poll.test.ts
new file mode 100644
index 0000000..7653a36
--- /dev/null
+++ b/src/components/request/poll.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from "vitest";
+import { pollIntervalMs } from "./poll";
+
+const now = Date.parse("2026-11-08T12:00:00Z");
+const minutesAgo = (m: number) => new Date(now - m * 60_000).toISOString();
+const open = (updated: number, events: number[] = []) => ({ terminal: false, updatedAt: minutesAgo(updated), events: events.map((m) => ({ type: "x", actor: "planner", at: minutesAgo(m) })) });
+
+describe("status page polling", () => {
+  it("polls no faster than the server cache while a request is moving", () => {
+    expect(pollIntervalMs(open(0.5), now)).toBe(8_000);
+    expect(pollIntervalMs(open(1), null)).toBe(8_000); // before the client clock starts
+  });
+
+  it("backs off once nothing has happened for a while, counting the latest event too", () => {
+    expect(pollIntervalMs(open(10), now)).toBe(20_000);
+    expect(pollIntervalMs(open(10, [2]), now)).toBe(8_000);
+    expect(pollIntervalMs(open(45), now)).toBe(60_000);
+  });
+
+  it("only checks now and then once the request is finished", () => {
+    expect(pollIntervalMs({ ...open(0), terminal: true }, now)).toBe(120_000);
+  });
+});
diff --git a/src/components/request/poll.ts b/src/components/request/poll.ts
new file mode 100644
index 0000000..d9a25cb
--- /dev/null
+++ b/src/components/request/poll.ts
@@ -0,0 +1,16 @@
+/** How often a request's status page asks for news. Pure, so it is tested on its own (poll.test.ts). */
+import type { RequestProgress } from "@/lib/dashboard/public";
+
+/**
+ * The server caches each request's progress for 8 s, so polling faster buys nothing. Once nothing has happened
+ * for a while (waiting on the customer or a founder) the page slows down, and a finished request only checks now
+ * and then (Neon $250 rule, NOTES H4c). `now` is null until the client clock starts.
+ */
+export function pollIntervalMs(p: Pick<RequestProgress, "terminal" | "updatedAt" | "events">, now: number | null): number {
+  if (p.terminal) return 120_000;
+  const last = Math.max(Date.parse(p.updatedAt) || 0, ...p.events.map((e) => Date.parse(e.at) || 0));
+  const quiet = now === null || !last ? 0 : now - last;
+  if (quiet > 30 * 60_000) return 60_000;
+  if (quiet > 5 * 60_000) return 20_000;
+  return 8_000;
+}
