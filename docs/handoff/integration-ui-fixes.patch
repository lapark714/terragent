new file mode 100644
index 0000000..44a7424
--- /dev/null
+++ b/src/components/dashboard/RecordPayment.tsx
@@ -0,0 +1,107 @@
+"use client";
+/**
+ * Customers pay through a founder's Stripe link, and nothing reports that back on its own. A founder records each
+ * payment here so revenue and the funnel's paid stage count it; it posts to /api/admin/payment and, like every
+ * founder action, lands in the public intervention log with the founder's reason.
+ */
+import { useId, useState } from "react";
+import type { RequestMoney } from "@/lib/dashboard/types";
+import { usd } from "../format";
+import { postAdmin, useAdminSession } from "./useAdminSession";
+
+const input =
+  "mt-1 w-full rounded-md border border-line-strong bg-space px-2 py-1 text-sm text-fg focus:border-inbound-hi focus:outline-none";
+
+/** What is still owed on a row, if anything: the suggested amount when a founder picks that request. */
+function owed(r: RequestMoney | undefined): string {
+  if (!r || r.price === null) return "";
+  const rest = Math.round((r.price - r.paid) * 100) / 100;
+  return String(rest > 0 ? rest : r.price);
+}
+
+export function RecordPayment({ requests, onDone }: { requests: RequestMoney[]; onDone?: () => void }) {
+  const { session, save } = useAdminSession();
+  const listId = useId();
+  const [open, setOpen] = useState(false);
+  const [requestId, setRequestId] = useState("");
+  const [amount, setAmount] = useState("");
+  const [reason, setReason] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState<{ ok: boolean; message: string } | null>(null);
+
+  if (!session) {
+    return <p className="text-xs leading-snug text-fg-3">Customers pay through the Stripe link; a founder records each payment here once founder controls are unlocked.</p>;
+  }
+
+  const priced = requests.filter((r) => r.price !== null && !r.sample);
+
+  function pick(value: string) {
+    setRequestId(value);
+    const row = priced.find((r) => r.id === value.trim());
+    if (row && !amount) setAmount(owed(row));
+  }
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    if (!session) return;
+    setBusy(true);
+    const r = await postAdmin(session, "payment", { request_id: requestId.trim(), amount_usd: Number(amount), reason: reason.trim() });
+    setBusy(false);
+    setResult(r);
+    if (r.status === 401) save(null);
+    if (r.ok) {
+      setOpen(false);
+      setRequestId("");
+      setAmount("");
+      setReason("");
+      onDone?.();
+    }
+  }
+
+  return (
+    <div className="flex flex-col gap-2 border-t border-line pt-3">
+      {!open ? (
+        <button type="button" onClick={() => { setOpen(true); setResult(null); }}
+          className="self-start rounded-md border border-line-strong px-2.5 py-1 text-xs text-fg hover:border-fg-3">
+          Record a payment
+        </button>
+      ) : (
+        <form onSubmit={submit} className="flex flex-col gap-2" aria-label="Record a payment">
+          <div className="grid grid-cols-[minmax(0,1fr)_6rem] gap-2">
+            <label className="text-xs text-fg-2">
+              Request
+              <input required list={listId} value={requestId} onChange={(e) => pick(e.target.value)} placeholder="req_…"
+                pattern="\s*req_[a-z0-9]{4,32}\s*" title="The request id, as on this panel or in Stripe's client reference"
+                autoComplete="off" spellCheck={false} className={`${input} font-mono`} />
+              <datalist id={listId}>
+                {priced.map((r) => (
+                  <option key={r.id} value={r.id}>{`${usd(r.price)} quoted${r.paid ? `, ${usd(r.paid)} paid` : ""}`}</option>
+                ))}
+              </datalist>
+            </label>
+            <label className="text-xs text-fg-2">
+              Amount, $
+              <input required type="number" inputMode="decimal" min="0.01" max="100000" step="0.01" value={amount}
+                onChange={(e) => setAmount(e.target.value)} className={`${input} tabular-nums`} />
+            </label>
+          </div>
+          <label className="text-xs text-fg-2">
+            Why? This goes in the public intervention log.
+            <input required minLength={3} maxLength={500} value={reason} onChange={(e) => setReason(e.target.value)}
+              placeholder="Paid through the Stripe link" className={input} />
+          </label>
+          <div className="flex gap-2">
+            <button type="submit" disabled={busy}
+              className="rounded-md bg-inbound px-2.5 py-1 text-xs font-medium text-space hover:bg-inbound-hi disabled:opacity-60">
+              {busy ? "Recording…" : amount ? `Record ${usd(Number(amount))}` : "Record payment"}
+            </button>
+            <button type="button" onClick={() => setOpen(false)} className="rounded-md px-2.5 py-1 text-xs text-fg-2 hover:text-fg">
+              Cancel
+            </button>
+          </div>
+        </form>
+      )}
+      {result && <p role="status" className={`text-xs ${result.ok ? "text-fg-2" : "text-alert"}`}>{result.message}</p>}
+    </div>
+  );
+}
