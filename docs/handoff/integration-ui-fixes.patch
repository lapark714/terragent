diff --git a/src/components/dashboard/MarketPanel.tsx b/src/components/dashboard/MarketPanel.tsx
new file mode 100644
index 0000000..d9265ea
--- /dev/null
+++ b/src/components/dashboard/MarketPanel.tsx
@@ -0,0 +1,76 @@
+/**
+ * What buyers pay today for the alternatives to a satellite answer (site visits, drone inspections, audits), each
+ * price linked to the public page the market researcher read it from, next to our own floor price.
+ */
+import { PLAYBOOKS, type Playbook } from "@/lib/domain";
+import type { MarketPrice, MarketPrices } from "@/lib/dashboard/types";
+import { dateUtc, usd } from "../format";
+import { PLAYBOOK_BG, PLAYBOOK_LABEL } from "../palette";
+import { Quiet } from "./Panel";
+
+export function priceRange(r: Pick<MarketPrice, "low" | "high">): string {
+  if (r.low !== null && r.high !== null) return r.low === r.high ? usd(r.low) : `${usd(r.low)}–${usd(r.high)}`;
+  if (r.low !== null) return `from ${usd(r.low)}`;
+  if (r.high !== null) return `up to ${usd(r.high)}`;
+  return "–";
+}
+
+export function MarketPanel({ market }: { market: MarketPrices }) {
+  if (!market.rows.length) {
+    return <Quiet>The market researcher hasn&apos;t saved any cited prices yet. It reads public price pages once a day.</Quiet>;
+  }
+  const groups = PLAYBOOKS.map((p) => [p, market.rows.filter((r) => r.playbook === p)] as const).filter(([, rows]) => rows.length);
+  return (
+    <div className="scroll-quiet -mx-4 overflow-x-auto px-4">
+      <table className="w-full min-w-[40rem] text-sm">
+        <caption className="sr-only">Cited prices of today&apos;s alternatives, by playbook</caption>
+        <thead className="text-xs text-fg-3">
+          <tr>
+            <th scope="col" className="pb-2 text-left font-normal">What buyers do today</th>
+            <th scope="col" className="pb-2 text-right font-normal">Price</th>
+            <th scope="col" className="pb-2 pl-4 text-left font-normal">Per</th>
+            <th scope="col" className="pb-2 text-left font-normal">Turnaround</th>
+            <th scope="col" className="pb-2 text-left font-normal">Source</th>
+          </tr>
+        </thead>
+        {groups.map(([playbook, rows]) => (
+          <Group key={playbook} playbook={playbook} rows={rows} />
+        ))}
+      </table>
+    </div>
+  );
+}
+
+function Group({ playbook, rows }: { playbook: Playbook; rows: readonly MarketPrice[] }) {
+  return (
+    <tbody className="border-t border-line">
+      <tr>
+        <th scope="rowgroup" colSpan={5} className="pt-3 pb-1 text-left text-xs font-medium text-fg-2">
+          <span className="flex items-center gap-2">
+            <span className={`size-2 rounded-full ${PLAYBOOK_BG[playbook]}`} aria-hidden />
+            {PLAYBOOK_LABEL[playbook]}
+          </span>
+        </th>
+      </tr>
+      {rows.map((r) => (
+        <tr key={r.id} className="align-baseline">
+          <th scope="row" className="py-1.5 pr-4 text-left font-normal">{r.alternative}</th>
+          <td className="py-1.5 text-right whitespace-nowrap tabular-nums">{priceRange(r)}</td>
+          <td className="py-1.5 pr-4 pl-4 whitespace-nowrap text-fg-2">{r.unit.replace(/^per\s+/i, "")}</td>
+          <td className="py-1.5 pr-4 text-fg-2">{r.turnaround ?? "–"}</td>
+          <td className="max-w-[16rem] py-1.5 text-xs text-fg-3">
+            {r.sourceUrl ? (
+              <a href={r.sourceUrl} target="_blank" rel="noopener noreferrer nofollow"
+                className="line-clamp-1 text-fg-2 underline decoration-line-strong underline-offset-4 hover:text-fg">
+                {r.sourceTitle}
+              </a>
+            ) : (
+              <span className="line-clamp-1">{r.sourceTitle}</span>
+            )}
+            <span>read {dateUtc(r.retrievedAt)}</span>
+          </td>
+        </tr>
+      ))}
+    </tbody>
+  );
+}
